# =============================================================================
# inference-benchmark — TensorRT-LLM image
#
# Build:
#   docker build -f docker/Dockerfile.trtllm -t boothalgo01/bench-trtllm:latest .
#
# Run:
#   docker run --gpus all \
#     -v /path/to/hf_cache:/root/.cache/huggingface \
#     -e BENCH_BRANCH=main \
#     -p 8000:8000 \
#     boothalgo01/bench-trtllm:latest
#
# NOTE: TRT-LLM requires model conversion before serving.
# See: https://github.com/NVIDIA/TensorRT-LLM/tree/main/examples
# =============================================================================
FROM nvcr.io/nvidia/tritonserver:24.12-trtllm-python-py3

RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl vim \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /tmp/bench_requirements.txt
RUN pip install -q -r /tmp/bench_requirements.txt

COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

WORKDIR /workspace
ENTRYPOINT ["/entrypoint.sh"]
